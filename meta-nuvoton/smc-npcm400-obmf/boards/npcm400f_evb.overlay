/ {
	chosen {
		zephyr,legacy_console = &uart1;

		/* UARTs bridged to OBMF Serial channel 0 / 1 */
		openbic,obmf-serial-0 = &uart1;
		openbic,obmf-serial-1 = &uart2;
	};
};

&uart1 {
	status = "okay";
	current-speed = <115200>;

	/* ESPI UARTB to COM port B(SINB SOUTB)*/
	//pinctrl-0 = <&pinctrl_sinoutb_default>;

	/*EPSI UARTB to CR_UART2*/
	ext-loopback;
};

&uart2 {
	status = "okay";
	current-speed = <115200>;
};

&twd0 {
       status = "okay";
};


&i2c1a {
	clock-frequency = <I2C_BITRATE_STANDARD>;
	status = "okay";
};

&i2c1b {
    status = "disabled";
};

&i2c2a {
	status = "okay";
};

&i2c3a {
	status = "okay";
};

&i2c4a {
	status = "disabled";
};

&i2c4b {
	status = "disabled";
};

&i2c5a {
	status = "okay";
};

&i2c6a {
    status = "disabled";
};

&i2c6b {
	status = "disabled";
};

&i2c7a {
	status = "disabled";
};

&i2c8a {
    status = "disabled";
};

&i2c9a {
    status = "disabled";
};

&i2c10a {
    status = "disabled";
};

&i2c11a {
    status = "disabled";
};

&i2c12a {
    status = "disabled";
};

/* disable peci0, pin use by i3c */
&peci0 {
	status = "disabled";
};

#if 0
/* Use for I3C_5 controller */
&i3c5 {
	status = "okay";
	compatible = "nuvoton,npcm4-i3c";
	reg = <0x40004a00 0x200
	       0x4000d000 0x20
	       0x40015000 0x490>;
	reg-names = "i3c", "pmc", "pdma";
