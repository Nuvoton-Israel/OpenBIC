&spi_spim0_cs0 {
	status = "okay";
};

&spi_fiu0_cs1 {
	status = "okay";
};

&spi_spip1_cs0 {
	status = "okay";
};

&espi0 {
	status = "okay";
};

/* Enable VW GPIO controller and all bank nodes */
&vwgpio {
	status = "okay";

	/* Slave-to-Master (output, BIC->Host) */
	vwgpsm0  { status = "okay"; };
	vwgpsm1  { status = "okay"; };
	vwgpsm2  { status = "okay"; };
	vwgpsm3  { status = "okay"; };
	vwgpsm4  { status = "okay"; };
	vwgpsm5  { status = "okay"; };
	vwgpsm6  { status = "okay"; };
	vwgpsm7  { status = "okay"; };
	vwgpsm8  { status = "okay"; };
	vwgpsm9  { status = "okay"; };
	vwgpsm10 { status = "okay"; };
	vwgpsm11 { status = "okay"; };
	vwgpsm12 { status = "okay"; };
	vwgpsm13 { status = "okay"; };
	vwgpsm14 { status = "okay"; };
	vwgpsm15 { status = "okay"; };

	/* Master-to-Slave (input, Host->BIC) */
	vwgpms0  { status = "okay"; };
	vwgpms1  { status = "okay"; };
	vwgpms2  { status = "okay"; };
	vwgpms3  { status = "okay"; };
	vwgpms4  { status = "okay"; };
	vwgpms5  { status = "okay"; };
	vwgpms6  { status = "okay"; };
	vwgpms7  { status = "okay"; };
	vwgpms8  { status = "okay"; };
	vwgpms9  { status = "okay"; };
	vwgpms10 { status = "okay"; };
	vwgpms11 { status = "okay"; };
	vwgpms12 { status = "okay"; };
	vwgpms13 { status = "okay"; };
	vwgpms14 { status = "okay"; };
	vwgpms15 { 
		status = "okay"; 
		gpio-line-names =
		    "CPU100", "", "", "CPU200";
	};
};

&peci0 {
	status = "disabled";
};

/* Enable SGPIO0 (siox0)
 *   Output ports (0-7):  pin-offset=0,8,16,24,32,40,48,56  -> pins 0-63
 *   Input ports  (8-15): pin-offset=64,72,80,88,96,104,112,120 -> pins 64-127
 */
&sgpio0 {
	status = "okay";

	/* Output banks: SGPIO0_0 to SGPIO0_7 (pins 0-63) */
	sgpio0_0 {
		status = "okay";
		gpio-line-names =
            "SPIO00_OBMF_0", "SPIO00_OBMF_1", "SPIO00_OBMF_2", "SPIO00_OBMF_3",
			"SPIO00_OBMF_4", "SPIO00_OBMF_5", "SPIO00_OBMF_6", "SPIO00_OBMF_7";

	};
	sgpio0_1 {
		status = "okay";
	};
	sgpio0_2 {
		status = "okay";
	};
	sgpio0_3 {
		status = "okay";
	};
	sgpio0_4 {
		status = "okay";
	};
	sgpio0_5 {
		status = "okay";
	};
	sgpio0_6 {
		status = "okay";
		gpio-line-names =
            "BAN", "", "MIA", "",
			"", "", "", "";
	};
	sgpio0_7 {
		status = "okay";
	};

	/* Input banks: SGPIO0_8 to SGPIO0_f (pins 64-127) */
	sgpio0_8 {
		status = "okay";
	};
	sgpio0_9 {
		status = "okay";
	};
	sgpio0_a {
		status = "okay";
	};
	sgpio0_b {
		status = "okay";
	};
	sgpio0_c {
		status = "okay";
	};
	sgpio0_d {
		status = "okay";
	};
	sgpio0_e {
		status = "okay";
	};
	sgpio0_f {
		status = "okay";
	};
};

/* Enable SGPIO1 (siox1) for OBMF SGPIO channel (channel 6)
 *   Output ports (0-7):  pin-offset=0,8,16,24,32,40,48,56  -> pins 0-63   (SGPIO_0~63)
 *   Input ports  (8-15): pin-offset=64,72,80,88,96,104,112,120 -> pins 64-127 (SGPIO_64~127)
 */
&sgpio1 {
	status = "okay";

	/* Output banks: SGPIO1_0 to SGPIO1_7 (pins 0-63) */
	sgpio1_0 {
		status = "okay";
	};
	sgpio1_1 {
		status = "okay";
	};
	sgpio1_2 {
		status = "okay";
	};
	sgpio1_3 {
		status = "okay";
	};
	sgpio1_4 {
		status = "okay";
	};
	sgpio1_5 {
		status = "okay";
	};
	sgpio1_6 {
		status = "okay";
	};
	sgpio1_7 {
		status = "okay";
	};

	/* Input banks: SGPIO1_8 to SGPIO1_f (pins 64-127) */
	sgpio1_8 {
		status = "okay";
	};
	sgpio1_9 {
		status = "okay";
	};
	sgpio1_a {
		status = "okay";
	};
	sgpio1_b {
		status = "okay";
	};
	sgpio1_c {
		status = "okay";
	};
	sgpio1_d {
		status = "okay";
	};
	sgpio1_e {
		status = "okay";
	};
	sgpio1_f {
		status = "okay";
	};
};
