/* The OBMF I3C Controller channel uses i3c4 (A9/B9) */
&i3c5 {
	status = "disabled";
};

#if 0
&i3c5 {
	bcr = <0x66>;
	dcr = <0xCC>;
	part-id = <0x1234>;
	vendor-def-id = <0x5607>;
	slave;
	secondary;
	status = "okay";
	i3c5_smq:i3c-slave-mqueue@21 {
		compatible = "i3c-slave-mqueue";
		reg = <0x21>;
		msg-size = <256>;
		num-of-msgs = <8>;
		mandatory-data-byte = <0xae>;
		label = "I3C_SMQ_5";
		status = "okay";
	};
};
#endif

#if 1
