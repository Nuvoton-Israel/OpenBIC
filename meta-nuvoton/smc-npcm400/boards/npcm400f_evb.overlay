/ {
	chosen {
		zephyr,legacy_console = &uart1;
	};
};

&uart1 {
	status = "okay";
	current-speed = <115200>;

	/* ESPI UARTB to COM port B(SINB SOUTB)*/
	pinctrl-0 = <&pinctrl_sinoutb_default>;

	/*EPSI UARTB to CR_UART2*/
	//ext-loopback;
};

&twd0 {
       status = "okay";
};


/* MCTP over SMBus to BMC */
&i2c1a {
	clock-frequency = <I2C_BITRATE_STANDARD>;
	status = "okay";
};

&i2c1b {
    status = "disabled";
};

&i2c2a {
	status = "disabled";
};

&i2c3a {
	status = "disabled";
};

&i2c4a {
    status = "disabled";
};

&i2c4b {
	status = "disabled";
};

&i2c5a {
	status = "disabled";
};

&i2c6a {
    status = "disabled";
};

&i2c6b {
	status = "disabled";
};

&i2c7a {
	status = "disabled";
};

&i2c8a {
    status = "disabled";
};

&i2c9a {
    status = "disabled";
};

&i2c10a {
    status = "disabled";
};

&i2c11a {
    status = "disabled";
};

&i2c12a {
    status = "disabled";
};

/* disable peci0, pin use by i3c */
&peci0 {
	status = "disabled";
};

/*
 * DT node i3cN drives the I3C(N+1) pins: i3c4 is I3C5_SCL/SDA (B9/A9),
 * i3c5 is I3C6_SCL/SDA (A5/B5).
 */
&i3c5 {
	status = "disabled";
};

/* MCTP over I3C target to BMC, on the I3C5 pins */
&i3c4 {
	bcr = <0x66>;
	dcr = <0xCC>;
	part-id = <0x1234>;
	vendor-def-id = <0x5607>;
	slave;
	secondary;
	status = "okay";
	i3c4_smq:i3c-slave-mqueue@20 {
		compatible = "i3c-slave-mqueue";
		reg = <0x20>;
		msg-size = <256>;
		num-of-msgs = <8>;
		mandatory-data-byte = <0xae>;
		label = "I3C_SMQ_4";
		status = "okay";
	};
};

